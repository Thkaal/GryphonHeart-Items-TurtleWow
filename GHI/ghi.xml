	<Button name="GHIContainerFrameItemButtonTemplate" inherits="ItemButtonTemplate" hidden="true" virtual="true">
		<Anchors>
			<Anchor point="BOTTOMRIGHT">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Model name="$parentCooldown" inherits="CooldownFrameTemplate"/>
		</Frames>
		<Scripts>
			<OnClick>
				if ( not ( GHI_IsModifierKeyDown() or IsShiftKeyDown() ) ) then
					GHI_ContainerFrameItemButton_OnClick(arg1);
				end
				-- Vanilla 1.12 has no PostClick script; run modified-click handling here.
				GHI_ContainerFrameItemButton_OnModifiedClick(arg1);
			</OnClick>
			<OnLoad>
				--ContainerFrameItemButton_OnLoad();
				GHI_ContainerFrameItemButton_OnLoad();
			</OnLoad>
			<OnEnter>
				GHI_ContainerFrameItemButton_OnEnter(this);
			</OnEnter>
			<OnLeave>
				this.updateTooltip = nil;
				GameTooltip:Hide();
				--ResetCursor();
			</OnLeave>
			<OnHide>
				if ( this.hasStackSplit and (this.hasStackSplit == 1) ) then
					StackSplitFrame:Hide();
				end
				
			</OnHide>
			<OnShow>
				if this:GetName() == "GHIContainerFrame1" then
					GHI_BackpackButton:SetChecked(true);
				end
			</OnShow>
			<OnDragStart>
				if ( not ( GHI_IsModifierKeyDown() or IsShiftKeyDown() ) ) then
					GHI_ContainerFrameItemButton_OnClick(arg1);
				end
				
			</OnDragStart>
			<OnDragStop>
				GHI_ContainerFrameItemButton_OnDragStop();
			</OnDragStop>
			<OnReceiveDrag>
				
			</OnReceiveDrag>
			<OnUpdate>
				GHI_ContainerFrameItemButton_OnUpdate(arg1); --
			</OnUpdate>
			<OnEvent>
				if ( GameTooltip:IsOwned(this) ) then
					GHI_ContainerFrameItemButton_OnEnter(this);
				end
			</OnEvent>
		</Scripts>
	</Button>
	
	
