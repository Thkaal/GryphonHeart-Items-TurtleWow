	<CheckButton name="GHI_BackpackButton" inherits="ItemButtonTemplate" parent="UIParent" id="100" frameStrata="HIGH">
		<Size>
			<AbsDimension x="37" y="37"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER">
				<Offset>
					<AbsDimension x="0" y="200"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Model name="$parentItemAnim" inherits="ItemAnimTemplate">
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-10" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Model>
		</Frames>
		<Scripts>
			<OnLoad>
				GHI_BackpackButtonIconTexture:SetTexture("Interface\\Icons\\INV_Misc_Bag_07_Blue");
				this:RegisterForDrag("LeftButton")
			</OnLoad>
			<OnClick>
				GHI_BackpackButton:SetChecked(false);
				GHI_ToggleBackpack();
			</OnClick>
			<OnReceiveDrag>
				
			</OnReceiveDrag>
			<OnEnter>
				
				GameTooltip:SetOwner(this, "ANCHOR_LEFT");
				GameTooltip:ClearLines()
				GameTooltip:AddLine(GHI_BAG_BNT, 1.0, 1.0, 1.0);
				GameTooltip:AddLine(GHI_BAG_DRAG);
				
				GameTooltip:Show();
				this.UpdateTooltip = nil;
			</OnEnter>
			<OnDragStart>
				if IsShiftKeyDown() then
					GHI_BPDrag = true;
				else
					GHI_BPDrag = false;
				end
			</OnDragStart>
			<OnDragStop>
				GHI_BPDrag = false;
			</OnDragStop>
			<OnUpdate>
				GHI_BPIconMove();
			</OnUpdate>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
			
		</Scripts>
		<CheckedTexture alphaMode="ADD" file="Interface\Buttons\CheckButtonHilight"/>
	</CheckButton>
	
