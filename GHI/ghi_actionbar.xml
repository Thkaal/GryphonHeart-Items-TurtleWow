	<CheckButton name="GHIActionBarButtonTemplate" inherits="SecureActionButtonTemplate, ActionButtonTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				GHI_ActionSlotButton_OnLoad();
				
			</OnLoad>
			<OnAttributeChanged>
				--ActionButton_UpdateAction();
			</OnAttributeChanged>
			<OnEvent>
				--ActionButton_OnEvent(event);
			</OnEvent>
			<OnDragStart>
				GHI_ActionSlotButton_OnClick(true);
			</OnDragStart>
			<OnClick>
				GHI_ActionSlotButton_OnClick(false);
			</OnClick>
			<OnReceiveDrag>
				GHI_ActionSlotButton_OnClick(false);
			</OnReceiveDrag>
			<OnEnter>
				
				
				GHI_ActionSlotButton_OnEnter()
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
			<OnUpdate>
				if not(this.loaded == true) then
					this.loaded = true;
					GHI_ActionSlotButton_OnLoad();
				end
				GHI_ActionSlotButton_OnUpdate()
			</OnUpdate>
		</Scripts>
	</CheckButton>
	
